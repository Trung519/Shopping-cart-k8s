# Reuse the exact existing application dependencies; add pinned tracing libraries.
# The baseline image must be available locally before this k3d build.
FROM shopping-cart-product-catalog:v1.4.2-rabbit-consumer-20260906
USER root
RUN /opt/venv/bin/pip install --no-cache-dir \
    opentelemetry-sdk==1.45.0 \
    opentelemetry-exporter-otlp-proto-http==1.45.0 \
    opentelemetry-instrumentation-fastapi==0.66b0 \
    opentelemetry-instrumentation-sqlalchemy==0.66b0
COPY --chown=1000:1000 src/ /app/src/
USER appuser
