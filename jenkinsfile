pipeline {
    agent {
        label 'AZURE-UP-IP165'
    }

    environment {
        // ==============================
        // Azure Container Registry
        // ==============================
        ACR_LOGIN_SERVER = 'klaaracimbtfe.azurecr.io'
        ACR_CREDENTIALS_ID = 'klaaracimbtfe-secret-id'

        // ==============================
        // OpenShift
        // ==============================
        OCP_NAMESPACE = 'cimb-tfe-dev'
        OCP_API_SERVER = 'https://api.t4avdnfn.southeastasia.aroapp.io:6443'

        KUBECONFIG = "${WORKSPACE}/.kubeconfig"

        // ==============================
        // Helm
        // ==============================
        HELM_VERSION = 'v3.15.4'

        // Pinned scanner images for reproducible security gates.
        GITLEAKS_IMAGE = 'zricethezav/gitleaks:v8.24.3'
        TRIVY_IMAGE = 'aquasec/trivy:0.61.1'
        HELM_BIN = "${WORKSPACE}/bin/helm"

        // Fixed infra source. Deliberately not exposed as a build parameter.
        INFRA_REPO = 'cimb-infra'
        INFRA_BRANCH = 'release/mvp1-origin'
        INFRA_CREDENTIALS_ID = 'bitbucket-cimb-infra-token'

        /*
         * Store Helm cache/config in workspace because the OpenShift CLI
         * container may run with a non-root user.
         */
        HELM_CONFIG_HOME = "${WORKSPACE}/.helm/config"
        HELM_CACHE_HOME = "${WORKSPACE}/.helm/cache"
        HELM_DATA_HOME = "${WORKSPACE}/.helm/data"
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.REPOS?.trim()) {
                        error '[PARAMETER ERROR] REPOS is required'
                    }

                    if (!params.SOURCE_BRANCH?.trim()) {
                        error '[PARAMETER ERROR] SOURCE_BRANCH is required'
                    }

                    def repoConfig = getRepoConfig()

                    def selectedRepos = params.REPOS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    if (selectedRepos.isEmpty()) {
                        error '[PARAMETER ERROR] No repository selected'
                    }

                    selectedRepos.each { repoName ->
                        if (!repoConfig[repoName]) {
                            error "[PARAMETER ERROR] Missing configuration for repository: ${repoName}"
                        }
                    }

                    def requestedImageTag = params.IMAGE_TAG?.trim()

                    echo """
                    ==========================================
                    SELECTED REPOS : ${selectedRepos.join(', ')}
                    SOURCE BRANCH : ${params.SOURCE_BRANCH.trim()}
                    IMAGE TAG     : ${requestedImageTag ?: 'AUTO (short Git commit ID)'}
                    DEPLOY OCP    : ${params.ENABLE_DEPLOY_OCP}
                    ==========================================
                    """
                }
            }
        }

        stage('Checkout Sources') {
            steps {
                script {
                    def repoConfig = getRepoConfig()
                    selectedRepoNames().each { repoName ->
                        dir(repoName) {
                            checkoutRepo(
                                repoConfig[repoName].credentialsId,
                                params.SOURCE_BRANCH.trim()
                            )
                        }
                    }
                }
            }
        }

        stage('Unit Test & Lint') {
            steps {
                script {
                    selectedRepoNames().each { repoName ->
                        dir(repoName) {
                            runQualityGate(repoName)
                        }
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    selectedRepoNames().each { repoName ->
                        dir(repoName) {
                            scanSecrets(repoName)
                            scanLibraries(repoName)
                            scanConfig(repoName)
                        }
                    }
                }
            }
        }
        stage('Build & Push') {
            steps {
                script {
                    def repoConfig = getRepoConfig()

                    def selectedRepos = params.REPOS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    selectedRepos.each { repoName ->
                        def cfg = repoConfig[repoName]

                        dir(repoName) {

                            def finalTag = resolveImageTag(params.IMAGE_TAG)

                            // Save the resolved tag once and reuse it in deployment stages.
                            env.FINAL_IMAGE_TAG = finalTag

                            echo """
                            ==========================================
                            BUILD REPO : ${repoName}
                            BRANCH     : ${params.SOURCE_BRANCH.trim()}
                            IMAGE TAG  : ${finalTag}
                            IMAGE      : ${env.ACR_LOGIN_SERVER}/${cfg.imageName}:${finalTag}
                            ==========================================
                            """

                            if (repoName == 'sftp-go-svc') {
                                echo '[BUILD] sftp-go-svc only applies Helm chart. Skipping build and push.'
                            } else {
                                if (repoName == 'moai-api'|| repoName == 'ms-sso-svc') {
                                    echo '[BUILD] moai-api builds directly from Dockerfile. Skipping build-script.sh.'
                                } else {
                                    prepareBuildContext(repoName)
                                }

                                buildAndPush(
                                    env.ACR_LOGIN_SERVER,
                                    env.ACR_CREDENTIALS_ID,
                                    repoName,
                                    cfg,
                                    finalTag
                                )
                            }
                        }
                    }
                }
            }
        }

        stage('Checkout Helm Charts') {
            when {
                expression {
                    return params.ENABLE_DEPLOY_OCP == true
                }
            }

            steps {
                dir('cimb-infra') {
                    checkoutRepo(
                        env.INFRA_CREDENTIALS_ID,
                        env.INFRA_BRANCH
                    )
                }
            }
        }

        /*
         * Helm creates or updates Deployment, Service, ConfigMap,
         * Route, Secret references and other resources.
         *
         * Do not use --wait or --atomic here because the image will
         * be changed by oc set image in the next stage.
         */
        stage('Deploy Helm Chart') {
            when {
                expression {
                    return params.ENABLE_DEPLOY_OCP == true
                }
            }

            agent {
                docker {
                    image 'quay.io/openshift/origin-cli:latest'
                    reuseNode true
                }
            }

            steps {
                script {
                    def repoConfig = getRepoConfig()

                    installHelm()
                    loginOCP()

                    def selectedRepos = params.REPOS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    selectedRepos.each { repoName ->
                        def cfg = repoConfig[repoName]

                        if (!cfg.releaseName?.trim() || !cfg.helmchartFolder?.trim()) {
                            echo """
                            [HELM] Helm deployment is not configured for ${repoName}.
                            [HELM] Skipping Helm deployment for this repository.
                            """

                        } else {
                            echo """
                            ==========================================
                            HELM REPO    : ${repoName}
                            RELEASE NAME : ${cfg.releaseName}
                            INFRA BRANCH : ${env.INFRA_BRANCH}
                            CHART FOLDER : ${cfg.helmchartFolder}
                            VALUES FILE  : ${cfg.helmchartFolder}/values.yaml
                            DEPLOYMENT   : ${cfg.deployment}
                            NAMESPACE    : ${env.OCP_NAMESPACE}
                            ==========================================
                            """

                            dir(env.INFRA_REPO) {
                                deployHelmChartToOCP(
                                    env.OCP_NAMESPACE,
                                    cfg
                                )
                            }
                        }
                    }
                }
            }
        }

        /*
         * After Helm deploys the chart, update the Deployment image
         * to the image created by the Build & Push stage.
         */
        stage('Update Deployment Image') {
            when {
                expression {
                    return params.ENABLE_DEPLOY_OCP == true
                }
            }

            agent {
                docker {
                    image 'quay.io/openshift/origin-cli:latest'
                    reuseNode true
                }
            }

            steps {
                script {
                    def repoConfig = getRepoConfig()

                    loginOCP()

                    def selectedRepos = params.REPOS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    selectedRepos.each { repoName ->
                        def cfg = repoConfig[repoName]

                        if (repoName == 'sftp-go-svc') {
                            echo '[OCP] sftp-go-svc image is managed by Helm. Skipping image update.'
                        } else if (!cfg.deployment?.trim()) {
                            echo """
                            [OCP] No Deployment configured for ${repoName}.
                            [OCP] Skipping image update.
                            """

                        } else {
                            def finalTag = env.FINAL_IMAGE_TAG?.trim()

                            if (!finalTag) {
                                error '[IMAGE TAG ERROR] FINAL_IMAGE_TAG is empty. Build & Push must run first.'
                            }

                            echo """
                            ==========================================
                            DEPLOY REPO : ${repoName}
                            DEPLOYMENT  : ${cfg.deployment}
                            IMAGE TAG   : ${finalTag}
                            IMAGE       : ${env.ACR_LOGIN_SERVER}/${cfg.imageName}:${finalTag}
                            NAMESPACE   : ${env.OCP_NAMESPACE}
                            ==========================================
                            """

                            deployToOCP(
                                env.OCP_NAMESPACE,
                                cfg.deployment,
                                cfg.containerName ?: '',
                                cfg.imageName,
                                env.ACR_LOGIN_SERVER,
                                finalTag
                            )
                        }
                    }
                }
            }
        }

        stage('Deployment Summary') {
            when {
                expression {
                    return params.ENABLE_DEPLOY_OCP == true
                }
            }

            agent {
                docker {
                    image 'quay.io/openshift/origin-cli:latest'
                    reuseNode true
                }
            }

            steps {
                script {
                    def repoConfig = getRepoConfig()

                    loginOCP()

                    def selectedRepos = params.REPOS
                        .split(',')
                        .collect { it.trim() }
                        .findAll { it }

                    selectedRepos.each { repoName ->
                        def cfg = repoConfig[repoName]

                        if (cfg.deployment?.trim()) {
                            showDeploymentSummary(
                                env.OCP_NAMESPACE,
                                cfg.deployment
                            )
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo '=========================================='
            echo 'Pipeline completed successfully'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'Pipeline failed. Please review the logs.'
            echo '=========================================='
        }

        always {
            cleanWs()
        }
    }
}


