{
  "id": null,
  "uid": "shopcart-performance",
  "title": "ShopCart Performance",
  "tags": ["shopcart", "k6"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Virtual Users",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "k6_vus{run_id=~\"$run_id\"}", "legendFormat": "VUs", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "sum(rate(k6_http_reqs_total{run_id=~\"$run_id\"}[1m]))", "legendFormat": "requests/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Flow Duration p95",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, flow) (rate(shopcart_flow_duration_bucket{run_id=~\"$run_id\"}[1m])))", "legendFormat": "{{flow}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Failures",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "sum by (status) (rate(k6_http_reqs_total{run_id=~\"$run_id\", status!~\"2..\"}[1m]))", "legendFormat": "HTTP {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Business Success",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "100 * avg(shopcart_business_success{run_id=~\"$run_id\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "ShopCart App Restarts",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 17},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "max_over_time(shopcart_app_restarts_total{run_id=~\"$run_id\"}[$__range]) - min_over_time(shopcart_app_restarts_total{run_id=~\"$run_id\"}[$__range])", "legendFormat": "Restart delta", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 17},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "sum(k6_http_reqs_total{run_id=~\"$run_id\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Orders Verified",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 17},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [{"expr": "sum(shopcart_orders_verified_total{run_id=~\"$run_id\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ready Pods",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "shopcart-performance"},
      "targets": [
        {"expr": "shopcart_app_ready_pods{run_id=~\"$run_id\"}", "legendFormat": "Ready", "refId": "A"},
        {"expr": "shopcart_app_total_pods{run_id=~\"$run_id\"}", "legendFormat": "Total", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ],
  "templating": {
    "list": [{"name": "run_id", "type": "query", "label": "Run ID", "datasource": {"type": "prometheus", "uid": "shopcart-performance"}, "query": {"query": "label_values(k6_http_reqs_total, run_id)", "refId": "run-id-variable"}, "refresh": 1, "includeAll": false, "current": {"text": "manual", "value": "manual"}}]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "annotations": {"list": []},
  "links": []
}
